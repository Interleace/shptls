import customtkinter as ctk
import tkinter.messagebox as msgbox
from tkinter import ttk
import threading
from datetime import datetime
import tempfile
import platform
import subprocess
import os
import webbrowser
import json # Für den Export der Bestelldetails

# Plattformabhängige Imports für den Druck
if platform.system() == "Windows":
    try:
        import win32print
        import win32api
    except ImportError:
        # Fallback falls win32-Module nicht verfügbar sind (z.B. wenn pywin32 nicht installiert ist)
        class DummyWin32:
            def __getattr__(self, name):
                def dummy_function(*args, **kwargs):
                    print(f"Dummy-Funktion '{name}' aufgerufen mit args={args}, kwargs={kwargs}")
                    return None
                return dummy_function
        win32print = DummyWin32()
        win32api = DummyWin32()
else:
    # Dummy-Objekte für Nicht-Windows-Systeme
    class DummyWin32:
        def __getattr__(self, name):
            def dummy_function(*args, **kwargs):
                print(f"Dummy-Funktion '{name}' aufgerufen mit args={args}, kwargs={kwargs}")
                return None
            return dummy_function
    win32print = DummyWin32()
    win32api = DummyWin32()

class StatusChangeDialog(ctk.CTkToplevel):
    def __init__(self, parent, current_status):
        super().__init__(parent)
        self.title("Status ändern")
        # Zentrieren Sie das Fenster auf dem Bildschirm
        self.update_idletasks()
        x = parent.winfo_x() + (parent.winfo_width() / 2) - (self.winfo_width() / 2)
        y = parent.winfo_y() + (parent.winfo_height() / 2) - (self.winfo_height() / 2)
        self.geometry(f"300x150+{int(x)}+{int(y)}")
        self.transient(parent) # Stellt sicher, dass das Dialogfenster über dem Hauptfenster bleibt
        # FIX: Call grab_set() after the window has been updated/drawn
        self.after(0, self.grab_set)

        self.new_status = None
        # Liste der gängigen WooCommerce-Status
        statuses = ["pending", "processing", "on-hold", "completed", "cancelled", "refunded", "failed"]

        ctk.CTkLabel(self, text="Neuen Status wählen:").pack(pady=10)
        self.status_combobox = ctk.CTkComboBox(self, values=statuses)
        self.status_combobox.set(current_status) # Aktuellen Status als Standardwert setzen
        self.status_combobox.pack(pady=5)

        button_frame = ctk.CTkFrame(self, fg_color="transparent") # Transparent, um den Rahmen zu entfernen
        button_frame.pack(pady=10)

        ctk.CTkButton(button_frame, text="OK", command=self.on_ok).pack(side="left", padx=5)
        ctk.CTkButton(button_frame, text="Abbrechen", command=self.on_cancel).pack(side="right", padx=5)

    def on_ok(self):
        self.new_status = self.status_combobox.get()
        self.destroy() # Schließt das Dialogfenster

    def on_cancel(self):
        self.new_status = None
        self.destroy() # Schließt das Dialogfenster

# NEUE KLASSE: EditOrderDialog mit Scrollbar
class EditOrderDialog(ctk.CTkToplevel):
    def __init__(self, parent, order_data):
        super().__init__(parent)
        self.title(f"Bestellung {order_data.get('id', 'N/A')} bearbeiten")
        self.geometry("800x700") # Startbreite erhöhen
        self.update_idletasks()

        self.order_data = order_data
        self.edited_data = {} # Dictionary to store changes

        # Verwenden Sie ein CTkScrollableFrame für den Inhalt
        self.scrollable_frame = ctk.CTkScrollableFrame(self)
        self.scrollable_frame.pack(fill="both", expand=True, padx=10, pady=10)

        # Konfigurieren der Spalten im ScrollableFrame
        self.scrollable_frame.grid_columnconfigure(0, weight=1)
        self.scrollable_frame.grid_columnconfigure(1, weight=3) # Inhaltspalte breiter

        current_row = 0

        # --- General Order Details ---
        ctk.CTkLabel(self.scrollable_frame, text="Allgemeine Details", font=("Roboto", 14, "bold")).grid(row=current_row, column=0, columnspan=2, pady=(10, 5), sticky="w", padx=10)
        current_row += 1

        # Status
        ctk.CTkLabel(self.scrollable_frame, text="Status:").grid(row=current_row, column=0, sticky="w", padx=10, pady=2)
        statuses = ["pending", "processing", "on-hold", "completed", "cancelled", "refunded", "failed"]
        self.status_var = ctk.StringVar(value=order_data.get('status', ''))
        self.status_combobox = ctk.CTkComboBox(self.scrollable_frame, values=statuses, variable=self.status_var)
        self.status_combobox.grid(row=current_row, column=1, sticky="ew", padx=10, pady=2)
        current_row += 1

        # Total (read-only for now, as line items aren't editable)
        ctk.CTkLabel(self.scrollable_frame, text="Summe:").grid(row=current_row, column=0, sticky="w", padx=10, pady=2)
        self.total_entry = ctk.CTkEntry(self.scrollable_frame, textvariable=ctk.StringVar(value=order_data.get('total', '0.00')), state="readonly")
        self.total_entry.grid(row=current_row, column=1, sticky="ew", padx=10, pady=2)
        current_row += 1

        # Customer Note
        ctk.CTkLabel(self.scrollable_frame, text="Kundennotiz:").grid(row=current_row, column=0, sticky="nw", padx=10, pady=2)
        self.customer_note_textbox = ctk.CTkTextbox(self.scrollable_frame, height=80, wrap="word") # Höhe erhöht
        self.customer_note_textbox.grid(row=current_row, column=1, sticky="ew", padx=10, pady=2)
        self.customer_note_textbox.insert("1.0", order_data.get('customer_note', ''))
        current_row += 1

        # --- Billing Address ---
        ctk.CTkLabel(self.scrollable_frame, text="Rechnungsadresse", font=("Roboto", 14, "bold")).grid(row=current_row, column=0, columnspan=2, pady=(10, 5), sticky="w", padx=10)
        current_row += 1
        self.billing_entries, current_row = self._create_address_fields(self.scrollable_frame, order_data.get('billing', {}), current_row)

        # --- Shipping Address ---
        ctk.CTkLabel(self.scrollable_frame, text="Lieferadresse", font=("Roboto", 14, "bold")).grid(row=current_row, column=0, columnspan=2, pady=(10, 5), sticky="w", padx=10)
        current_row += 1
        self.shipping_entries, current_row = self._create_address_fields(self.scrollable_frame, order_data.get('shipping', {}), current_row)


        # --- Buttons ---
        button_frame = ctk.CTkFrame(self, fg_color="transparent") # Buttons outside scrollable frame
        button_frame.pack(pady=10)
        ctk.CTkButton(button_frame, text="Speichern", command=self.on_save).pack(side="left", padx=10)
        ctk.CTkButton(button_frame, text="Abbrechen", command=self.on_cancel).pack(side="right", padx=10)

    def _create_address_fields(self, parent_frame, address_data, start_row):
        fields = [
            ("Vorname:", "first_name"), ("Nachname:", "last_name"), ("Firma:", "company"),
            ("Adresse 1:", "address_1"), ("Adresse 2:", "address_2"),
            ("Stadt:", "city"), ("Bundesland:", "state"), ("PLZ:", "postcode"),
            ("Land:", "country"), ("Email:", "email"), ("Telefon:", "phone")
        ]
        entries = {}
        row_counter = start_row
        for label_text, key in fields:
            ctk.CTkLabel(parent_frame, text=label_text).grid(row=row_counter, column=0, sticky="w", padx=10, pady=2)
            entry_var = ctk.StringVar(value=address_data.get(key, ''))
            entry = ctk.CTkEntry(parent_frame, textvariable=entry_var)
            entry.grid(row=row_counter, column=1, sticky="ew", padx=10, pady=2)
            entries[key] = entry_var # Store the StringVar to easily get its value later
            row_counter += 1
        return entries, row_counter

    def on_save(self):
        # General details
        self.edited_data['status'] = self.status_var.get()
        self.edited_data['customer_note'] = self.customer_note_textbox.get("1.0", "end-1c").strip()

        # Billing Address
        self.edited_data['billing'] = {}
        for key, var in self.billing_entries.items():
            self.edited_data['billing'][key] = var.get()

        # Shipping Address
        self.edited_data['shipping'] = {}
        for key, var in self.shipping_entries.items():
            self.edited_data['shipping'][key] = var.get()

        self.destroy()

    def on_cancel(self):
        self.edited_data = None
        self.destroy()


class HistoryWindow(ctk.CTkToplevel):
    def __init__(self, parent, woo_api):
        super().__init__(parent)

        self.woo_api = woo_api
        self.orders = []
        self.sort_column = "ID"
        self.sort_direction = "descending"
        self.current_order = None # Zum Speichern der Details der aktuell ausgewählten Bestellung

        self.title("Bestellverlauf")
        self.geometry("1000x700") # Angepasste Fenstergröße
        self.transient(parent)
        # FIX: Call grab_set() after the window has been updated/drawn
        self.after(0, self.grab_set)


        # Laden-Label
        self.loading_label = ctk.CTkLabel(self, text="Lade Bestellungen...", font=("Roboto", 16))
        self.loading_label.pack(pady=20)

        # Such- und Filterleiste
        self.search_frame = ctk.CTkFrame(self)
        self.search_frame.pack(pady=10, padx=10, fill="x")

        ctk.CTkLabel(self.search_frame, text="Status Filter:").pack(side="left", padx=5)
        self.status_filter_combobox = ctk.CTkComboBox(self.search_frame,
                                                    values=["Alle", "pending", "processing", "on-hold", "completed", "cancelled", "refunded", "failed"],
                                                    command=self.filter_orders)
        self.status_filter_combobox.set("Alle")
        self.status_filter_combobox.pack(side="left", padx=5)

        ctk.CTkButton(self.search_frame, text="Bestellungen neu laden", command=self.load_orders).pack(side="right", padx=5)


        # Treeview für Bestellungen
        self.orders_tree_frame = ctk.CTkFrame(self)
        self.orders_tree_frame.pack(pady=10, padx=10, fill="both", expand=True)

        self.orders_tree = ttk.Treeview(self.orders_tree_frame, columns=("ID", "Datum", "Status", "Summe", "Kunde"), show="headings")
        self.orders_tree.pack(side="left", fill="both", expand=True)

        # Scrollbar für Treeview
        tree_scrollbar = ctk.CTkScrollbar(self.orders_tree_frame, command=self.orders_tree.yview)
        tree_scrollbar.pack(side="right", fill="y")
        self.orders_tree.configure(yscrollcommand=tree_scrollbar.set)

        # Spaltenkonfiguration
        columns = {
            "ID": {"width": 80, "anchor": "center"},
            "Datum": {"width": 150, "anchor": "w"},
            "Status": {"width": 100, "anchor": "center"},
            "Summe": {"width": 90, "anchor": "e"},
            "Kunde": {"width": 200, "anchor": "w"}
        }

        for col, props in columns.items():
            self.orders_tree.heading(col, text=col, command=lambda c=col: self.sort_treeview(c))
            self.orders_tree.column(col, width=props["width"], anchor=props["anchor"])

        self.orders_tree.bind("<<TreeviewSelect>>", self.on_order_select)


        # Detaillierte Ansicht der Bestellung
        self.details_frame = ctk.CTkFrame(self)
        self.details_frame.pack(pady=10, padx=10, fill="x")

        ctk.CTkLabel(self.details_frame, text="Bestelldetails:").pack(anchor="w")
        self.details_textbox = ctk.CTkTextbox(self.details_frame, height=100, wrap="word")
        self.details_textbox.pack(fill="x", pady=5)
        self.details_textbox.configure(state="disabled") # Standardmäßig deaktiviert

        # Buttons für Aktionen
        self.action_buttons_frame = ctk.CTkFrame(self)
        self.action_buttons_frame.pack(pady=10, padx=10, fill="x")

        ctk.CTkButton(self.action_buttons_frame, text="Rechnung drucken", command=self.print_invoice).pack(side="left", padx=5)
        ctk.CTkButton(self.action_buttons_frame, text="Status ändern", command=self.change_order_status).pack(side="left", padx=5)
        ctk.CTkButton(self.action_buttons_frame, text="Bestelldetails exportieren", command=self.export_order_details).pack(side="left", padx=5)
        ctk.CTkButton(self.action_buttons_frame, text="Bestellung bearbeiten", command=self.edit_order, fg_color="green").pack(side="left", padx=5)


        self.load_orders() # Initiales Laden der Bestellungen

    def show_loading(self, show):
        if show:
            self.loading_label.pack(pady=20)
            self.orders_tree_frame.pack_forget()
            self.details_frame.pack_forget()
            self.action_buttons_frame.pack_forget()
            self.search_frame.pack_forget() # Hide search/filter during loading
        else:
            self.loading_label.pack_forget()
            self.search_frame.pack(pady=10, padx=10, fill="x")
            self.orders_tree_frame.pack(pady=10, padx=10, fill="both", expand=True)
            self.details_frame.pack(pady=10, padx=10, fill="x")
            self.action_buttons_frame.pack(pady=10, padx=10, fill="x")


    def load_orders(self):
        def _load():
            self.after(0, lambda: self.show_loading(True))
            try:
                # Hier können Sie weitere Parameter wie 'per_page' oder 'page' hinzufügen
                # um Paginierung zu handhaben, falls Sie viele Bestellungen haben.
                fetched_orders = self.woo_api.get_orders(per_page=100) # Lädt die neuesten 100 Bestellungen
                self.orders = sorted(fetched_orders, key=lambda x: x.get('id', 0), reverse=True) # Standardmäßig nach ID absteigend sortieren
                self.after(0, self.populate_orders_tree)
            except Exception as e:
                self.after(0, lambda: msgbox.showerror("Fehler", f"Fehler beim Laden der Bestellungen: {e}"))
            finally:
                self.after(0, lambda: self.show_loading(False))

        threading.Thread(target=_load, daemon=True).start()

    def populate_orders_tree(self):
        # Löschen der vorhandenen Einträge
        for item in self.orders_tree.get_children():
            self.orders_tree.delete(item)

        current_filter_status = self.status_filter_combobox.get()
        filtered_orders = []

        for order in self.orders:
            order_status = order.get('status', 'unknown')
            if current_filter_status == "Alle" or order_status == current_filter_status:
                filtered_orders.append(order)

        # Sortieren der gefilterten Bestellungen
        sorted_orders = self.sort_data(filtered_orders)

        for order in sorted_orders:
            order_id = order.get('id', 'N/A')
            order_date_raw = order.get('date_created', '')
            order_status = order.get('status', 'N/A')
            order_total = order.get('total', '0.00')
            customer_info = "N/A"

            if 'billing' in order:
                billing = order['billing']
                first_name = billing.get('first_name', '')
                last_name = billing.get('last_name', '')
                customer_info = f"{first_name} {last_name}".strip()
                if not customer_info: # Fallback if names are empty
                    customer_info = billing.get('email', 'N/A')

            # Datum formatieren
            formatted_date = "N/A"
            if order_date_raw:
                try:
                    dt_object = datetime.fromisoformat(order_date_raw.replace('Z', '+00:00')) # ISO 8601 mit Z
                    formatted_date = dt_object.strftime("%d.%m.%Y %H:%M")
                except ValueError:
                    pass # Keep "N/A" if formatting fails

            # Währungssymbol hinzufügen
            currency_symbol = order.get('currency_symbol', '€') # Annahme Euro als Standard
            formatted_total = f"{order_total} {currency_symbol}"

            self.orders_tree.insert("", "end", iid=order_id, values=(order_id, formatted_date, order_status, formatted_total, customer_info), tags=(order_id,))


    def sort_treeview(self, col):
        # Umkehren der Sortierrichtung, wenn auf die gleiche Spalte geklickt wird
        if self.sort_column == col:
            self.sort_direction = "ascending" if self.sort_direction == "descending" else "descending"
        else:
            self.sort_column = col
            self.sort_direction = "ascending" # Standard: aufsteigend beim ersten Klick

        # Neu laden der Bestellungen mit der neuen Sortierung
        self.populate_orders_tree()

    def sort_data(self, data):
        # Helper function to get the correct sort key
        def get_sort_key(order):
            if self.sort_column == "ID":
                return int(order.get('id', 0))
            elif self.sort_column == "Datum":
                try:
                    return datetime.fromisoformat(order.get('date_created', '1970-01-01T00:00:00Z').replace('Z', '+00:00'))
                except ValueError:
                    return datetime.min # Fallback for invalid dates
            elif self.sort_column == "Status":
                return order.get('status', '').lower()
            elif self.sort_column == "Summe":
                try:
                    return float(order.get('total', '0.0'))
                except ValueError:
                    return 0.0
            elif self.sort_column == "Kunde":
                billing = order.get('billing', {})
                return f"{billing.get('first_name', '')} {billing.get('last_name', '')}".strip().lower()
            return ""

        return sorted(data, key=get_sort_key, reverse=(self.sort_direction == "descending"))

    def filter_orders(self, selected_status):
        self.populate_orders_tree() # Ruft populate_orders_tree auf, die den Filter anwendet


    def on_order_select(self, event):
        selected_items = self.orders_tree.selection()
        if selected_items:
            selected_id = self.orders_tree.item(selected_items[0], 'tags')[0]
            # Find the full order object from the loaded orders list
            self.current_order = next((order for order in self.orders if str(order.get('id')) == str(selected_id)), None)
            if self.current_order:
                self.display_order_details(self.current_order)
            else:
                self.details_textbox.configure(state="normal")
                self.details_textbox.delete("1.0", "end")
                self.details_textbox.insert("1.0", "Details für diese Bestellung konnten nicht gefunden werden.")
                self.details_textbox.configure(state="disabled")
                self.current_order = None # Reset if order not found


    def display_order_details(self, order_data):
        details = []
        details.append(f"Bestellnummer: {order_data.get('id', 'N/A')}")
        details.append(f"Status: {order_data.get('status', 'N/A')}")
        details.append(f"Datum erstellt: {order_data.get('date_created', 'N/A')}")
        details.append(f"Datum aktualisiert: {order_data.get('date_modified', 'N/A')}")
        details.append(f"Summe: {order_data.get('total', 'N/A')} {order_data.get('currency_symbol', '€')}")
        details.append(f"Währung: {order_data.get('currency', 'N/A')}")

        # Kundeninformationen
        billing = order_data.get('billing', {})
        details.append("\nKundeninformationen:")
        details.append(f"  Name: {billing.get('first_name', '')} {billing.get('last_name', '')}")
        details.append(f"  Firma: {billing.get('company', 'N/A')}")
        details.append(f"  Email: {billing.get('email', 'N/A')}")
        details.append(f"  Telefon: {billing.get('phone', 'N/A')}")
        details.append(f"  Adresse: {billing.get('address_1', '')}, {billing.get('address_2', '')}")
        details.append(f"  PLZ/Ort: {billing.get('postcode', '')} {billing.get('city', '')}")
        details.append(f"  Land: {billing.get('country', 'N/A')}")

        # Lieferinformationen (falls vorhanden und anders als Rechnungsadresse)
        shipping = order_data.get('shipping', {})
        if shipping and (shipping.get('address_1') != billing.get('address_1') or shipping.get('first_name') != billing.get('first_name')):
            details.append("\nLieferinformationen:")
            details.append(f"  Name: {shipping.get('first_name', '')} {shipping.get('last_name', '')}")
            details.append(f"  Firma: {shipping.get('company', 'N/A')}")
            details.append(f"  Adresse: {shipping.get('address_1', '')}, {shipping.get('address_2', '')}")
            details.append(f"  PLZ/Ort: {shipping.get('postcode', '')} {shipping.get('city', '')}")
            details.append(f"  Land: {shipping.get('country', 'N/A')}")

        # Bestellte Artikel
        details.append("\nBestellte Artikel:")
        for item in order_data.get('line_items', []):
            details.append(f"  - {item.get('name', 'N/A')} (x{item.get('quantity', 1)}) - {item.get('total', '0.00')} {order_data.get('currency_symbol', '€')}")

        # Versanddetails
        shipping_lines = order_data.get('shipping_lines', [])
        if shipping_lines:
            details.append("\nVersand:")
            for s_line in shipping_lines:
                details.append(f"  - {s_line.get('method_title', 'N/A')}: {s_line.get('total', '0.00')} {order_data.get('currency_symbol', '€')}")

        # Zahlungsdetails
        details.append("\nZahlung:")
        details.append(f"  Methode: {order_data.get('payment_method_title', 'N/A')}")

        self.details_textbox.configure(state="normal")
        self.details_textbox.delete("1.0", "end")
        self.details_textbox.insert("1.0", "\n".join(details))
        self.details_textbox.configure(state="disabled")


    def print_invoice(self):
        if not self.current_order:
            msgbox.showwarning("Warnung", "Bitte wählen Sie eine Bestellung aus, für die eine Rechnung erstellt werden soll.")
            return

        order_id = self.current_order.get('id')
        temp_dir = tempfile.gettempdir()
        pdf_final_path = os.path.join(temp_dir, f"invoice_{order_id}.pdf")

        def _create_and_print():
            self.after(0, lambda: self.show_loading(True))
            creation_result = None
            try:
                msgbox.showinfo("Druckvorgang", "Rechnung wird aus Bestelldetails lokal erstellt. Bitte warten...")

                # Lokale Rechnungserstellung mit den vorhandenen Bestelldetails
                creation_result = self.woo_api.create_invoice_pdf(self.current_order, pdf_final_path)

                if creation_result is True:
                    # Erfolgreich eine PDF erstellt
                    self.after(0, lambda: self._print_pdf(pdf_final_path))
                elif isinstance(creation_result, str) and os.path.exists(creation_result):
                    # PDF-Erstellung schlug fehl, aber wir haben eine HTML-Datei
                    self.after(0, lambda: self._handle_html_invoice(creation_result, order_id))
                else:
                    # Fallback-Fehlermeldung
                    self.after(0, lambda: msgbox.showerror("Fehler", "Rechnung konnte nicht erstellt werden."))

            except Exception as e:
                self.after(0, lambda: msgbox.showerror("Fehler bei Rechnungsstellung", f"Fehler beim Erstellen der PDF-Rechnung: {e}"))
            finally:
                self.after(0, lambda: self.show_loading(False))
                # Temporäre PDF-Datei aufräumen
                if creation_result is True and os.path.exists(pdf_final_path):
                    try:
                        os.remove(pdf_final_path)
                    except OSError as e_os:
                        print(f"Warnung: Temporäre PDF-Datei konnte nicht gelöscht werden: {e_os}")

        threading.Thread(target=_create_and_print, daemon=True).start()

    def _handle_html_invoice(self, html_path, order_id):
        """
        Handles the case where the invoice was received as HTML and could not be converted to PDF.
        Offers to open the HTML in a browser for manual printing.
        """
        response = msgbox.askyesno("Rechnung als HTML erstellt",
                                    f"Die Rechnung wurde als HTML-Datei erstellt, konnte aber nicht automatisch in eine PDF-Datei konvertiert werden.\n\n"
                                    f"Möchten Sie die HTML-Rechnung im Browser öffnen, um sie manuell zu drucken?")
        if response:
            try:
                webbrowser.open(f"file://{os.path.abspath(html_path)}")
                msgbox.showinfo("HTML geöffnet", "Die Rechnung wurde als HTML im Browser geöffnet. Bitte drucken Sie sie von dort aus.")
            except Exception as e:
                msgbox.showerror("Fehler", f"Konnte HTML-Datei im Browser nicht öffnen: {e}")
            finally:
                # Temporäre HTML-Datei aufräumen
                if os.path.exists(html_path):
                    try:
                        os.remove(html_path)
                    except OSError as e:
                        print(f"Warnung: Temporäre HTML-Datei ({html_path}) konnte nicht gelöscht werden: {e}")
        else:
            # Temporäre HTML-Datei aufräumen, wenn der Benutzer sie nicht öffnet
            if os.path.exists(html_path):
                try:
                    os.remove(html_path)
                except OSError as e:
                    print(f"Warnung: Temporäre HTML-Datei ({html_path}) konnte nicht gelöscht werden: {e}")

    def _print_pdf(self, pdf_path):
        system = platform.system()
        try:
            if system == "Windows":
                printer_info = self._get_default_printer_info()
                print(f"DEBUG: {printer_info}")
                result = win32api.ShellExecute(0, "print", pdf_path, None, ".", 0)
                if result <= 32:
                    raise Exception(f"ShellExecute Fehlercode: {result}. Stellen Sie sicher, dass ein PDF-Viewer als Standardprogramm festgelegt ist.")
                msgbox.showinfo("Druckvorgang", f"Rechnung ({os.path.basename(pdf_path)}) an den Standarddrucker gesendet.")

            elif system == "Linux":
                subprocess.run(["lp", pdf_path], check=True)
                msgbox.showinfo("Druckvorgang", f"Rechnung ({os.path.basename(pdf_path)}) an den Standarddrucker gesendet (Linux).")

            elif system == "Darwin": # macOS
                subprocess.run(["lpr", pdf_path], check=True)
                msgbox.showinfo("Druckvorgang", f"Rechnung ({os.path.basename(pdf_path)}) an den Standarddrucker gesendet (macOS).")

            else:
                message = f"Direktes Drucken für Ihr Betriebssystem ({system}) nicht unterstützt. Die PDF wird im Browser geöffnet. Bitte drucken Sie von dort aus manuell."
                webbrowser.open(f"file://{os.path.abspath(pdf_path)}")
                msgbox.showinfo("Drucken im Browser", message)

        except subprocess.CalledProcessError as e:
            message = f"Fehler beim Senden der Druckanfrage ({system}): {e}. Versuche, PDF im Browser zu öffnen."
            webbrowser.open(f"file://{os.path.abspath(pdf_path)}")
            msgbox.showerror("Druckfehler", message)
        except Exception as e:
            message = f"Allgemeiner Druckfehler ({system}): {e}. Versuche, PDF im Browser zu öffnen."
            webbrowser.open(f"file://{os.path.abspath(pdf_path)}")
            msgbox.showerror("Druckfehler", message)

    def _get_default_printer_info(self):
        """Gibt Informationen über den Standarddrucker zurück (nur für Debugging/Info)"""
        system = platform.system()

        if system == "Windows":
            try:
                printer_name = win32print.GetDefaultPrinter()
                return f"Windows-Standarddrucker: {printer_name}"
            except Exception as e:
                return f"Konnte Windows-Drucker nicht ermitteln: {e}"

        elif system == "Linux":
            try:
                result = subprocess.run(["lpstat", "-d"], capture_output=True, text=True, check=True)
                return f"Linux-Standarddrucker: {result.stdout.strip()}"
            except Exception as e:
                return f"Konnte Linux-Drucker nicht ermitteln: {e}"

        elif system == "Darwin":
            try:
                result = subprocess.run(["lpstat", "-d"], capture_output=True, text=True, check=True)
                return f"macOS-Standarddrucker: {result.stdout.strip()}"
            except Exception as e:
                return f"Konnte macOS-Drucker nicht ermitteln: {e}"
        else:
            return f"Druckerinformationen für '{system}' nicht verfügbar"


    def change_order_status(self):
        selected_item = self.orders_tree.selection()
        if not selected_item:
            msgbox.showwarning("Warnung", "Bitte wählen Sie eine Bestellung aus, deren Status geändert werden soll.")
            return

        order_id = self.orders_tree.item(selected_item[0], 'tags')[0]
        current_status = self.orders_tree.item(selected_item[0], 'values')[2] # Aktuellen Status aus Treeview holen

        dialog = StatusChangeDialog(self, current_status.lower()) # Dialog aufrufen und aktuellen Status übergeben
        self.wait_window(dialog) # Warten, bis der Dialog geschlossen wird

        new_status = dialog.new_status

        if new_status: # Nur fortfahren, wenn der Benutzer im Dialog "OK" geklickt hat (new_status ist nicht None)
            def update_status_in_background():
                try:
                    self.after(0, lambda: self.show_loading(True))
                    self.woo_api.update_order_status(order_id, new_status)
                    self.after(0, lambda: msgbox.showinfo("Erfolg", f"Status für Bestellung {order_id} auf '{new_status}' aktualisiert."))
                    self.after(0, self.load_orders) # Bestellungen neu laden, um die Änderung anzuzeigen
                    self.after(0, lambda: self.show_loading(False))
                except Exception as e:
                    self.after(0, lambda: msgbox.showerror("Fehler", f"Status konnte nicht aktualisiert werden: {e}"))
                    self.after(0, lambda: self.show_loading(False))

            threading.Thread(target=update_status_in_background, daemon=True).start()
        else:
            msgbox.showinfo("Abgebrochen", "Statusänderung abgebrochen.")

    def edit_order(self):
        if not self.current_order:
            msgbox.showwarning("Warnung", "Bitte wählen Sie eine Bestellung aus, die bearbeitet werden soll.")
            return

        dialog = EditOrderDialog(self, self.current_order)
        self.wait_window(dialog)

        edited_data = dialog.edited_data

        if edited_data:
            def update_order_in_background():
                try:
                    self.after(0, lambda: self.show_loading(True))
                    order_id = self.current_order.get('id')
                    # Prepare data for API: only send fields that are editable
                    update_payload = {
                        'status': edited_data.get('status', self.current_order.get('status')),
                        'customer_note': edited_data.get('customer_note', self.current_order.get('customer_note')),
                        'billing': edited_data.get('billing', self.current_order.get('billing')),
                        'shipping': edited_data.get('shipping', self.current_order.get('shipping')),
                    }
                    self.woo_api.update_order(order_id, update_payload)
                    self.after(0, lambda: msgbox.showinfo("Erfolg", f"Bestellung {order_id} erfolgreich aktualisiert."))
                    self.after(0, self.load_orders) # Reload orders to show changes
                    self.after(0, lambda: self.show_loading(False))
                except Exception as e:
                    self.after(0, lambda: msgbox.showerror("Fehler", f"Fehler beim Aktualisieren der Bestellung: {e}"))
                    self.after(0, lambda: self.show_loading(False))

            threading.Thread(target=update_order_in_background, daemon=True).start()
        else:
            msgbox.showinfo("Abgebrochen", "Bestellbearbeitung abgebrochen.")

    def export_order_details(self):
        if not hasattr(self, 'current_order') or not self.current_order:
            msgbox.showwarning("Warnung", "Keine Bestellung ausgewählt zum Exportieren.")
            return

        try:
            from tkinter import filedialog
            file_path = filedialog.asksaveasfilename(
                defaultextension=".json", # Standarderweiterung
                filetypes=[("JSON files", "*.json"), ("Text files", "*.txt"), ("All files", "*.*")],
                title="Bestelldetails exportieren nach"
            )

            if not file_path: # Benutzer hat Dialog abgebrochen
                msgbox.showinfo("Abgebrochen", "Export abgebrochen.")
                return

            # Export als JSON, da es die gesamte Struktur beibehält
            with open(file_path, 'w', encoding='utf-8') as f:
                json.dump(self.current_order, f, indent=4, ensure_ascii=False)

            msgbox.showinfo("Export erfolgreich", f"Bestelldetails wurden erfolgreich nach '{file_path}' exportiert.")

        except Exception as e:
            msgbox.showerror("Export Fehler", f"Fehler beim Exportieren der Bestelldetails: {e}")
